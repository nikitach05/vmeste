{% set title = "Home page" %}
{% extends "layouts/main.njk" %}

{% block content %}

<main class="main" style="background-image: url('/src/assets/img/image.webp');">
    <div class="main__container container">
        <div class="main__content">
            <div class="main__under-title">Интеллектуальная среда &Брачное агентство</div>
            <h1 class="main__title"><span class="main__title-text">ДАВАЙ ВМЕСТЕ</span></h1>
            <div class="main__description"><span>Ценностный фундамент</span> семьи и отношений</div>
            <ul class="main__list">
                <li class="main__list-item">Формируем окружение под ваши ценности</li>
                <li class="main__list-item">Организуем интересные события и интеллектуальный досуг</li>
                <li class="main__list-item">Создаём условия для искреннего общения</li>
                <li class="main__list-item">Помогаем найти близких по духу людей</li>
            </ul>
            <div class="main__buttons">
                <button class="btn btn--primary" type="button" data-modal="order-modal">Присоединиться</button>
                <button class="btn btn--trans">Погрузиться в контекст</button>
            </div>
        </div>
        
        <div class="main__clients">
            <div class="main__clients-item">
                <img class="main__clients-img" src="/src/assets/img/clients/logo1.svg" loading="lazy" alt="">
            </div>
            <div class="main__clients-item">
                <img class="main__clients-img" src="/src/assets/img/clients/logo2.png" loading="lazy" alt="">
            </div>
            <div class="main__clients-item">
                <img class="main__clients-img" src="/src/assets/img/clients/logo3.png" loading="lazy" alt="">
            </div>
            <div class="main__clients-item">
                <img class="main__clients-img" src="/src/assets/img/clients/logo4.svg" loading="lazy" alt="">
            </div>
            <div class="main__clients-item">
                <img class="main__clients-img" src="/src/assets/img/clients/logo5.svg" loading="lazy" alt="">
            </div>
            <div class="main__clients-item">
                <img class="main__clients-img" src="/src/assets/img/clients/logo6.svg" loading="lazy" alt="">
            </div>
            <div class="main__clients-item">
                <img class="main__clients-img" src="/src/assets/img/clients/logo7.svg" loading="lazy" alt="">
            </div>
            <div class="main__clients-item">
                <img class="main__clients-img" src="/src/assets/img/clients/logo8.png" loading="lazy" alt="">
            </div>
            <div class="main__clients-item">
                <img class="main__clients-img" src="/src/assets/img/clients/logo9.svg" loading="lazy" alt="">
            </div>
            <div class="main__clients-item">
                <img class="main__clients-img" src="/src/assets/img/clients/logo10.svg" loading="lazy" alt="">
            </div>
            <div class="main__clients-item">
                <img class="main__clients-img" src="/src/assets/img/clients/logo9.svg" loading="lazy" alt="">
            </div>
            <div class="main__clients-item">
                <img class="main__clients-img" src="/src/assets/img/clients/logo1.svg" loading="lazy" alt="">
            </div>
            <div class="main__clients-item">
                <img class="main__clients-img" src="/src/assets/img/clients/logo2.png" loading="lazy" alt="">
            </div>
        </div>
    </div>
</main>

<section class="for-whom p-indent" style="background-image: url('/src/assets/img/image.webp');">
    <div class="for-whom__container container">
        <div class="for-whom__content">
            <div class="for-whom__under-title under-title">{Кому подойдёт}</div>
            <h2 class="for-whom__title title">Для того, кто исключает случайность</h2>
            <div class="for-whom__description">Контекст для создания семьи в атмосфере безусловного принятия и доверия. <strong>Мы берем на себя фильтрацию среды, чтобы вы могли быть собой среди равных.</strong></div>
        </div>
    </div>
</section>

<section class="formats pt-indent">
    <div class="container">
        <div class="formats__header">
            <div class="formats__under-title under-title">{Форматы}</div>
            <h2 class="formats__title title">Экосистема осмысленных отношений</h2>
            <div class="formats__description f18-20">Единый контекст — два уровня погружения</div>
        </div>

        <div class="formats__grid">
            <article class="formats__card">
                <div class="formats__media">
                    <img src="/src/assets/img/image2.webp" alt="">
                </div>
                <div class="formats__body">
                    <h3 class="formats__card-title">Селективная среда</h3>
                    <p class="formats__card-text">Сообщество, в котором синергия ценностей становится основой глубоких связей</p>
                    <ul class="formats__list">
                        <li>живые клубные встречи в культурном контексте</li>
                        <li>подбор качественного окружения</li>
                        <li>герметичное и модерируемое пространство</li>
                        <li>единомыслие и взаимопонимание</li>
                    </ul>
                    <button class="btn btn--primary formats__btn" type="button">Стать частью сообщества</button>
                </div>
            </article>

            <article class="formats__card formats__card--agency">
                <div class="formats__card-bg" style="background-image: url('/src/assets/img/image4.webp');"></div>
                <div class="formats__media">
                    <img src="/src/assets/img/image3.webp" alt="">
                </div>
                <div class="formats__body">
                    <h3 class="formats__card-title">Брачное агентство</h3>
                    <p class="formats__card-text">Сопровождение на всех этапах к осознанному построению семьи</p>
                    <ul class="formats__list">
                        <li>точность в подборе партнёра</li>
                        <li>стратегическое создание семейного наследия</li>
                        <li>ценностный отбор и верификация</li>
                        <li>конфиденциальность и взаимное уважение</li>
                    </ul>
                    <button class="btn btn--primary formats__btn" type="button">Записаться на встречу</button>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="for-you p-indent">
    <div class="container">
        <div class="for-you__layout">
            <div class="for-you__under-title under-title">{Это для вас}</div>
            <div class="for-you__main">
                <h2 class="for-you__title title">На чём построен проект<br>«Давай вместе»</h2>
                <div class="for-you__grid">
                    <div class="for-you__item">
                        <h3 class="for-you__item-title">Внимание к личности</h3>
                        <p class="for-you__item-text">психологический подход, рефлексия и осознанность</p>
                    </div>
                    <div class="for-you__item">
                        <h3 class="for-you__item-title">Создание семьи</h3>
                        <p class="for-you__item-text">династический фундамент и долгосрочное наследие</p>
                    </div>
                    <div class="for-you__item">
                        <h3 class="for-you__item-title">Ценностный подбор</h3>
                        <p class="for-you__item-text">среда равных по масштабу, этике и жизненным смыслам</p>
                    </div>
                    <div class="for-you__item">
                        <h3 class="for-you__item-title">Селективное сообщество</h3>
                        <p class="for-you__item-text">люди с общими ценностями в едином контексте</p>
                    </div>
                </div>
            </div>
            <div class="for-you__media">
                <img src="/src/assets/img/image5.webp" alt="">
            </div>
        </div>
    </div>
</section>

<section class="founder p-indent">
    <div class="container">
        <div class="founder__layout">
            <div class="founder__main">
                <h2 class="founder__title"><span>Основатель</span> <span>проекта</span></h2>
                <div class="founder__photo">
                    <img src="/src/assets/img/image6.webp" alt="Елена Барвина">
                </div>
                <div class="founder__intro">
                    <h3 class="founder__name">Елена Барвина</h3>
                    <p class="founder__role">Ваш медиатор в среде осознанных отношений</p>
                    <p class="founder__text">Восемь лет я организовывала свадебные торжества — безупречные декорации для начала пути. Но за красивым кадром я часто видела хрупкость союзов. Это побудило меня сменить фокус: вместо организации событий я стала помогать людям в создании семейного наследия.</p>
                </div>
                <p class="founder__aside">Я замужем уже 14 лет и могу сказать, что созидательный союз — это настоящая «командная игра». Когда дом становится крепостью взаимной поддержки, вы обретаете фундамент для династии и укрепления себя в этом мире.</p>
            </div>
            <div class="founder__side">
                <div class="founder__portrait">
                    <div class="founder__badge">Давайте создадим ваше сильное будущее вместе!</div>
                    <img src="/src/assets/img/image7.webp" alt="">
                </div>
                <div class="founder__notes">
                    <p class="founder__text">«Давай вместе» — это ответ инфошуму, жизненному хаосу и дефициту искренности. В&nbsp;этом проекте я ваш куратор, преобразующий искреннее желание найти своего человека в выверенный план действий.</p>
                    <p class="founder__text">Моя миссия — исключить случайность и&nbsp;создать «чистый контекст», где вы встречаете только резонирующих по масштабу и ценностям людей.</p>
                </div>
                <div class="founder__family">
                    <img src="/src/assets/img/image8.webp" alt="">
                </div>
            </div>
        </div>
    </div>

    <div class="marquee-text">
        <div class="marquee-text__item">ЗАКРЫТЫЙ КЛУБ И БРАЧНОЕ АГЕНТСТВО</div>
        <div class="marquee-text__item">ДАВАЙ ВМЕСТЕ ДАВАЙ ВМЕСТЕ</div>
    </div>
</section>

<section class="steps p-indent">
    <div class="container">
        <div class="steps__header">
            <div class="steps__under-title under-title">{Этапы}</div>
            <h2 class="steps__title"><span>Вступление</span> <span>в клуб</span></h2>
        </div>
        <div class="steps__layout">
            <div class="steps__list">
                <article class="steps__item steps__item--active">
                    <div class="steps__num">1/5</div>
                    <h3 class="steps__name">Заявка и верификация</h3>
                    <p class="steps__text">Вы оставляете запрос на получение доступа к экосистеме. Регистрация необходима для обеспечения комфорта резидентов и формирования безопасной среды.</p>
                </article>
                <article class="steps__item">
                    <div class="steps__num">2/5</div>
                    <h3 class="steps__name">Погружение в контекст</h3>
                    <p class="steps__text">После одобрения заявки вы знакомитесь с этическим кодексом, ценностями экосистемы и форматами участия для дальнейшего выбора.</p>
                </article>
                <article class="steps__item">
                    <div class="steps__num">3/5</div>
                    <h3 class="steps__name">Выбор формата участия</h3>
                    <p class="steps__text">Вы определяете вектор взаимодействия: участие в жизни селективного сообщества и его мероприятиях или переход к индивидуальному подбору пары в брачном агентстве.</p>
                </article>
                <article class="steps__item">
                    <div class="steps__num">4/5</div>
                    <h3 class="steps__name">Селективная среда</h3>
                    <p class="steps__text">Встречи с людьми с общими ценностями на культурных событиях, бизнес-завтраках, нетворкингах. Приятное и интеллектуальное времяпрепровождение.</p>
                </article>
                <article class="steps__item">
                    <div class="steps__num">5/5</div>
                    <h3 class="steps__name">Брачное агентство</h3>
                    <p class="steps__text">Персональный подбор партнера на основе ценностного созвучия и сопровождение на каждом этапе: от первой встречи до создания устойчивой и глубокой связи.</p>
                </article>
                <button class="btn btn--primary steps__apply" type="button" data-modal="order-modal">Подать заявку</button>
            </div>
            <div class="steps__panel">
                <div class="steps__panel-bg" style="background-image: url('/src/assets/img/image10.webp');"></div>
                <div class="steps__panel-body">
                    <div class="steps__panel-media">
                        <img class="is-active" src="/src/assets/img/image9.webp" alt="">
                        <img src="/src/assets/img/image11.webp" alt="">
                        <img src="/src/assets/img/image12.webp" alt="">
                        <img src="/src/assets/img/image13.webp" alt="">
                        <img src="/src/assets/img/image14.webp" alt="">
                    </div>
                    <div class="steps__panel-title">Заявка и верификация</div>
                    <button class="btn btn--primary" type="button" data-modal="order-modal">Подать заявку</button>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="environment p-indent" style="background-image: url('/src/assets/img/image15.webp');">
    <div class="container environment__container">
        <div class="environment__intro">
            <div class="environment__under-title under-title">{Среда}</div>
            <div class="environment__copy">
                <h2 class="environment__title">Герметичная<br> и модерируемая среда</h2>
                <div class="environment__brand">ДАВАЙ ВМЕСТЕ</div>
            </div>
        </div>
        <div class="environment__cards">
            <article class="environment__card">
                <img class="environment__card-icon" src="/src/assets/img/svg/icon1.svg" alt="">
                <h3 class="environment__card-title">Безупречная конфиденциальность</h3>
                <p class="environment__card-text">Непубличность — базовый принцип экосистемы. Личная информация и история взаимодействия не подлежат огласке и защищены внутренней политикой экосистемы.</p>
            </article>
            <article class="environment__card">
                <img class="environment__card-icon" src="/src/assets/img/svg/icon2.svg" alt="">
                <h3 class="environment__card-title">Конфиденциальность</h3>
                <p class="environment__card-text">Мы следим за уровнем контекста. Ценностный подбор резидентов позволяет сохранить в сообществе комфортную и содержательную почву для глубокого общения и совместного опыта.</p>
            </article>
            <article class="environment__card">
                <img class="environment__card-icon" src="/src/assets/img/svg/icon3.svg" alt="">
                <h3 class="environment__card-title">Конфиденциальность</h3>
                <p class="environment__card-text">Взаимоуважение и ответственность — фундамент нашей этики. Взаимодействие внутри проекта регулируется чёткими правилами. Мы гарантируем безопасное пространство доверия.</p>
            </article>
        </div>
    </div>
</section>

