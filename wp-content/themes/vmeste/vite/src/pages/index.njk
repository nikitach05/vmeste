        </div>
        <article class="partners__person active" data-block="partner-1">
            <div class="partners__photo">
                <img src="/src/assets/img/image16.webp" alt="">
            </div>
            <div class="partners__info">
                <h3 class="partners__person-name">Ксения Перепелкина</h3>
